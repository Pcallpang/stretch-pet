# 개발용 설정값 예시입니다.
#
# 주의: 이 프로그램은 .env 파일을 읽지 않습니다(dotenv를 쓰지 않습니다).
# 아래 값들은 "진짜 환경변수"로 설정해야만 적용되며, 설정하면
# package.json의 miyoConfig보다 우선합니다.
#
# 윈도우 PowerShell에서 이번 실행에만 적용하려면:
#   $env:MIYO_SERVER_URL = "http://localhost:3001"
#   $env:MIYO_GOOGLE_DESKTOP_CLIENT_ID = "여기에-클라이언트-ID"
#   npm start
#
# 윈도우 cmd.exe라면:
#   set MIYO_SERVER_URL=http://localhost:3001
#   set MIYO_GOOGLE_DESKTOP_CLIENT_ID=여기에-클라이언트-ID
#   npm start
#
# 계정에 영구 저장하려면(새 터미널부터 적용):
#   setx MIYO_SERVER_URL "http://localhost:3001"

MIYO_SERVER_URL=http://localhost:3001
MIYO_GOOGLE_DESKTOP_CLIENT_ID=
