{
  "name": "stretch-pet",
  "version": "0.3.0",
  "description": "화면 위를 돌아다니다 정해진 시간마다 스트레칭을 시켜주는 데스크톱 펫",
  "author": "Pcallpang",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke-test.cjs",
    "slice-sprites": "node scripts/slice-sprites.mjs",
    "package": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jimp": "^0.22.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "//miyoConfig": "배포 중에 빌드로 포함되는 설정값. 데스크톱 클라이언트 ID는 PKCE를 사용하므로 보안 정보가 아니며 커밋해도 안전함.",
  "miyoConfig": {
    "serverUrl": "https://miyo-planner.vercel.app",
    "desktopClientId": "280309938828-1tbv8eqqh1gmfbba51qfg4sig6qchcda.apps.googleusercontent.com"
  },
  "build": {
    "appId": "com.pcallpang.stretchpet",
    "productName": "StretchPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/index.html",
      "src/renderer/style.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  }
}
